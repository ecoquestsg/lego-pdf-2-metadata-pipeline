# Google Auth
# Your Google Cloud Project ID
PROJECT_ID="your-gcp-project-id"
# (Optional) If you want to force a specific credentials file instead of ADC login
# If you use `gcloud auth application-default login`, you can leave this blank.
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/your-service-account.json"


# Document AI (OCR)
# DocAI processor location (must match your processor)
# Examples: "asia-southeast1", "us", "eu"
LOCATION="your-docai-location"
# DocAI OCR processor ID (Document OCR processor)
PROCESSOR_ID="your-docai-processor-id"


# Vertex AI / Gemini
# Vertex AI location:
# - If using Gemini preview models, use "global"
# - Otherwise use your region, e.g. "asia-southeast1"
VERTEX_LOCATION="global"
# Gemini model name in Vertex
GEMINI_MODEL="gemini-3-flash-preview"
# Generation settings
GEMINI_TEMPERATURE="0.0"
GEMINI_MAX_OUTPUT_TOKENS="4096"
# Force JSON output if your SDK supports it
GEMINI_RESPONSE_MIME_TYPE="application/json"


# Local storage directories (local-first), already created in this repo
RAW_DIR="lego-raw-pdfs"
EXTRACTED_DIR="lego-extracted"
ENRICHED_DIR="lego-enriched"
RAWDOC_DIR="lego-rawdoc-objects"


# Specific to pipeline behavior:
# DocAI max pages per request before we split
MAX_PAGES_SYNC="15"
# Batch politeness delay in seconds (used by run_pipeline.py)
BATCH_MIN_DELAY="1.0"
BATCH_MAX_DELAY="2.0"
